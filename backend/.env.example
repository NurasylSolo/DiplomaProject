DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/senti_news
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o

CORS_ORIGINS=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@sentinews.kz

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
TASK_QUEUE_MODE=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TASKS_TOPIC=senti.tasks
KAFKA_SYNC_TOPIC=senti.sync
KAFKA_CONSUMER_GROUP=senti-workers
KAFKA_AUTO_OFFSET_RESET=earliest
SCHEDULER_ENABLED=true
SCHEDULER_REFRESH_INTERVAL_MINUTES=30
SENTRY_DSN=
