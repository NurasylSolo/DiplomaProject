# ===========================================================================
# Senti News backend — environment template.
# Copy to ".env" for local dev, OR set each of these as environment variables
# in your host (Render / Railway / VPS). NEVER commit real secrets.
# ===========================================================================

# --- Database (managed PostgreSQL). Must use the asyncpg driver. -----------
# Example (Neon/Render/Railway): postgresql+asyncpg://USER:PASS@HOST:5432/DB
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/sentinews

# --- Auth / JWT ------------------------------------------------------------
# Generate a long random value for production, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_SHORT_DAYS=7

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_SENTIMENT_MODEL=gpt-4o-mini

# --- News provider API keys ------------------------------------------------
NEWS_API_KEY=
SERP_API_KEY=
NEWSDATA_API_KEY=
EVENT_REGISTRY_API_KEY=
WORLD_NEWS_API_KEY=

# --- Google OAuth (add the production redirect URI in Google Cloud Console) -
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CORS: comma-separated list of allowed frontend origins ----------------
# Production: your deployed frontend URL(s). Include both apex and www if used.
CORS_ORIGINS=https://sentinews.online,https://www.sentinews.online

# --- SMTP (transactional email: verification, reports) ---------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sentinews.online

# --- Background task mode --------------------------------------------------
# "local" runs ingestion in-process (recommended for a single-instance deploy).
TASK_QUEUE_MODE=local
# Periodic auto-refresh of ALL projects. Keep false for a demo/single instance
# to avoid background load competing with live runs.
SCHEDULER_ENABLED=false
SCHEDULER_REFRESH_INTERVAL_MINUTES=30

# --- Optional integrations (leave disabled unless you provision them) ------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TASKS_TOPIC=senti.tasks
KAFKA_SYNC_TOPIC=senti.sync
KAFKA_CONSUMER_GROUP=senti-workers
KAFKA_AUTO_OFFSET_RESET=earliest

ENABLE_OPENSEARCH_SYNC=false
ENABLE_CLICKHOUSE=false
ENABLE_RAG_EMBEDDINGS=true
SENTRY_DSN=
